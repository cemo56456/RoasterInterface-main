#:kivy 2.2.0
#:import dp kivy.metrics.dp

# ---------------------------------------------------------
# Section header (e.g. "PROFILE")
# ---------------------------------------------------------
<SettingSection@Label>:
    size_hint_y: None
    height: dp(44)
    font_size: FONT_SM
    bold: True
    color: 0.0, 0.75, 0.85, 1
    halign: "left"
    valign: "bottom"
    text_size: self.size
    padding: dp(8), 0

# ---------------------------------------------------------
# One settings row: title + description on the left,
# the control (added as a child) on the right.
# ---------------------------------------------------------
<SettingRow@BoxLayout>:
    title: ""
    description: ""
    size_hint_y: None
    height: dp(96)
    padding: dp(22), dp(12)
    spacing: dp(16)
    default_container: ctrl
    canvas.before:
        Color:
            rgba: 0.12, 0.13, 0.16, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22),]

    BoxLayout:
        orientation: "vertical"
        spacing: dp(2)

        Label:
            text: root.title
            font_size: FONT_EMPH
            bold: True
            color: 1, 1, 1, 1
            halign: "left"
            valign: "bottom"
            text_size: self.size

        Label:
            text: root.description
            font_size: FONT_XS
            color: 0.65, 0.68, 0.74, 1
            halign: "left"
            valign: "top"
            text_size: self.size

    BoxLayout:
        id: ctrl
        size_hint_x: None
        width: dp(400)

# ---------------------------------------------------------
# Segmented option button (used inside a SettingRow)
# ---------------------------------------------------------
<SegButton@Button>:
    selected: False
    current: False
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    font_size: FONT_SM
    bold: True
    color: (1, 1, 1, 1) if self.selected else (0.78, 0.80, 0.85, 1)
    halign: "center"
    valign: "middle"
    text_size: self.size
    canvas.before:
        Color:
            rgba: (0.0, 0.55, 0.65, 1) if self.selected else (0.20, 0.22, 0.27, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14),]
        Color:
            rgba: (1.0, 0.85, 0.2, 1) if self.current else (0, 0, 0, 0)
        Line:
            rounded_rectangle: self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2), dp(14)
            width: dp(1.6)


# =========================================================
# SETTINGS SCREEN
# =========================================================
<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(12)

        canvas.before:
            Color:
                rgba: 0.07, 0.08, 0.10, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # ---------------- Header ----------------
        BoxLayout:
            size_hint_y: None
            height: dp(64)
            spacing: dp(12)

            DarkTab:
                text: "<  Back"
                font_size: FONT_LG
                bold: True
                size_hint_x: 0.3
                on_release: root.go_back()

            DarkTab:
                text: "Settings"
                tab_key: "live"
                font_size: FONT_LG
                bold: True
                state: "down"

        # ---------------- Settings list ----------------
        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
                padding: 0, 0, dp(8), dp(8)

                SettingSection:
                    text: "PROFILE"

                SettingRow:
                    title: "Roasting Profile Style"
                    description: "Active in PLC: " + ("DEV TIME" if root.current_mode == "dev" else "STANDARD")

                    SegButton:
                        text: "STANDARD"
                        selected: root.selected_mode == "standard"
                        current: root.current_mode == "standard"
                        on_release: root.select_mode("standard")
                    Widget:
                        size_hint_x: None
                        width: dp(8)
                    SegButton:
                        text: "DEV TIME"
                        selected: root.selected_mode == "dev"
                        current: root.current_mode == "dev"
                        on_release: root.select_mode("dev")

                # Yeni ayarlar buraya eklenecek:
                #   SettingSection:  text: "..."
                #   SettingRow:      title/description + kontrol

        # ---------------- Footer ----------------
        BoxLayout:
            size_hint_y: None
            height: dp(72)
            spacing: dp(12)

            Label:
                text: root.last_msg
                font_size: FONT_SM
                color: 1.0, 0.45, 0.45, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

            Button:
                text: "Apply"
                font_size: FONT_LG
                bold: True
                size_hint_x: None
                width: dp(260)
                disabled: not root.can_apply
                background_normal: ""
                background_down: ""
                background_disabled_normal: ""
                background_color: 0, 0, 0, 0
                color: (1, 1, 1, 1) if not self.disabled else (0.5, 0.52, 0.56, 1)
                canvas.before:
                    Color:
                        rgba: (0.20, 0.65, 0.30, 1) if not self.disabled else (0.18, 0.19, 0.22, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(22),]
                on_release: root.apply()
